# ================================
# GMB Review Earning Platform - Environment Variables
# ================================
# ---------- Flask Environment ----------
FLASK_ENV=development

# ---------- Secret Key ----------
SECRET_KEY=gmb_google_review_9876_321_r1o2u3

# ---------- Database ----------

# Live (Render/PostgreSQL) par apna DB URL yaha daalein
DATABASE_URL=

# ---------- Admin Login Credentials ----------
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123

# ---------- Mail Configuration (Gmail SMTP example) ----------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=apni_email_id_yahan_dalein@gmail.com
MAIL_APP_PASSWORD=16_digit_ka_app_password_yahan_dalein
MAIL_DEFAULT_SENDER=apni_email_id_yahan_dalein@gmail.com

# ---------- Rate Limiting (Redis - optional) ----------
# Agar Redis nahi use kar rahe to ye khali/'memory://' rakh sakte hain
REDIS_URL=memory://

# File Uploads
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif

# ---------- Server Port (Render deployment) ----------
PORT=10000
