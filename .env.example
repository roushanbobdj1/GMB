# Keep the SAME SECRET_KEY and DATABASE_URL used by the existing deployment.
APP_ENV=production
SECRET_KEY=replace-with-existing-production-secret
DATABASE_URL=replace-with-existing-database-url

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# Hostinger Email SMTP example. Use the mailbox's full address/password.
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=replace-with-mailbox-password
MAIL_DEFAULT_SENDER=no-reply@example.com
MAIL_TIMEOUT=20

# Use an absolute persistent path on Hostinger.
UPLOAD_FOLDER=/home/hostinger-user/domains/example.com/gmb/uploads/screenshots

AUTO_APPLY_ADDITIVE_MIGRATIONS=true
TRUST_PROXY_HEADERS=true
TASK_DEADLINE_DAYS=7
TASK_MAINTENANCE_INTERVAL_SECONDS=300
SOCKETIO_ASYNC_MODE=threading

# Optional when using multiple web workers.
# REDIS_URL=redis://127.0.0.1:6379/0
