# ==============================================================================
# GMB Earn — Environment Configuration Template (Hostinger & Render)
# ==============================================================================
# IMPORTANT FOR EXISTING HOSTINGER USERS:
# - NEVER overwrite your existing Hostinger .env or /etc/gmb-earn.env!
# - Keep your EXISTING SECRET_KEY and DATABASE_URL so all existing users stay
#   logged in and all wallet/task/encrypted payment records stay intact.
# ==============================================================================

# 'production' (Hostinger / Render live) or 'staging' (Render test)
APP_ENV=production

# Keep the EXACT existing SECRET_KEY on Hostinger! Generate a new one only for fresh installs.
SECRET_KEY=replace-with-your-secret-key

# Hostinger MySQL example:    mysql://db_user:db_pass@localhost:3306/db_name
# Render PostgreSQL example:  postgresql://db_user:db_pass@host:5432/db_name
DATABASE_URL=replace-with-existing-database-url

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# Email / SMTP (use either SSL on 465 OR TLS on 587 — never both true)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
MAIL_TIMEOUT=20

# Uploads directory (optional; defaults to <project_dir>/uploads/screenshots)
# Hostinger VPS example: /var/lib/gmb-earn/uploads/screenshots
# Render Disk example:   /var/data/uploads/screenshots
# UPLOAD_FOLDER=

# Safe additive-only schema check on boot (adds missing tables/columns, NEVER deletes data)
AUTO_APPLY_ADDITIVE_MIGRATIONS=true
TRUST_PROXY_HEADERS=true
SESSION_COOKIE_SECURE=true

TASK_DEADLINE_DAYS=7
TASK_MAINTENANCE_INTERVAL_SECONDS=300
SOCKETIO_ASYNC_MODE=threading

# Optional: comma-separated allowed origins for Socket.IO (e.g. https://yourdomain.com)
# SOCKETIO_ALLOWED_ORIGINS=https://yourdomain.com

# Optional: Redis URL for shared rate limiting
# REDIS_URL=redis://localhost:6379/0
